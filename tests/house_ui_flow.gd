extends SceneTree
const HousePanel=preload("res://scripts/house_plan_panel.gd")
func _initialize():call_deferred("run_test")
func run_test():
 var panel=HousePanel.new();root.add_child(panel)
 assert(panel.open_design("house","Elamu"))
 assert(not panel.more_actions.visible);panel.more_actions_button.pressed.emit();assert(panel.more_actions.visible);panel.more_actions_button.pressed.emit();assert(not panel.more_actions.visible)
 assert(panel.estimate_label.text.contains("Puit 10") and panel.estimate_label.text.contains("Kivi 58"))
 assert(panel.ledger_text.text.contains("✓ Tulekolle") and panel.ledger_text.text.contains("✓ Magamiskoht"))
 var no_fire:Dictionary=panel.canvas.design.duplicate(true);no_fire.items=no_fire.items.filter(func(item):return item.type!="fire")
 panel.update_measurements(no_fire);assert(panel.ledger_text.text.contains("○ Tulekolle"))
 assert(panel.tool_buttons.rect.visible and panel.tool_buttons.yard.visible and panel.tool_buttons.paintWall.visible and not panel.tool_buttons.rail.visible)
 panel.tool_buttons["build-open"].pressed.emit();assert(panel.canvas.current_plan().build=="open" and panel.tool_buttons["build-open"].button_pressed and not panel.tool_buttons["build-wall"].button_pressed)
 panel.tool_buttons["build-wall"].pressed.emit();assert(panel.canvas.current_plan().build=="wall" and panel.tool_buttons["build-wall"].button_pressed and not panel.tool_buttons["build-open"].button_pressed)
 panel.tool_buttons.paintWall.pressed.emit();assert(not panel.controls_panel.visible and panel.style_choices.visible and panel.choice_cards.size()>1)
 var wood_brush=panel.choice_cards.filter(func(card):return card.tooltip_text=="Puit")
 assert(panel.choice_cards.size()>=5);panel.choice_cards[4].pressed.emit();assert(panel.canvas.wall_brush=="wood")
 panel.select_category("facade");assert(not panel.options_panel.visible and panel.wall_choices.visible and not panel.roof_choices.visible)
 var plinth=panel.choice_cards.filter(func(card):return card.get_meta("plan_field","")=="base" and card.get_meta("plan_value","")=="plinth")[0]
 plinth.pressed.emit();assert(panel.canvas.current_plan().base=="plinth")
 panel.mode_move.pressed.emit();assert(panel.canvas.tool=="move" and panel.mode_move.button_pressed)
 panel.mode_erase.pressed.emit();assert(panel.canvas.tool=="erase" and panel.mode_erase.button_pressed and not panel.mode_move.button_pressed)
 panel.select_category("fence")
 assert(panel.tool_buttons.rail.visible and not panel.tool_buttons.rect.visible and not panel.tool_buttons.highStone.visible and not panel.tool_buttons.rampart.visible)
 panel.tool_buttons.rail.pressed.emit();assert(panel.canvas.tool=="rail")
 panel.select_category("inner");assert(panel.tool_buttons.paintWall.visible)
 panel.select_category("door");assert(panel.choice_cards.size()==2);panel.choice_cards[1].pressed.emit();assert(panel.canvas.tool=="door" and panel.canvas.style=="wattle");panel.tool_buttons.door.pressed.emit()
 assert(panel.canvas.tool=="door" and panel.style_choices.visible and panel.style_choices.item_count>0)
 panel.select_category("settings");assert(not panel.options_panel.visible and panel.card_scroll.visible and panel.choice_cards.size()>=5)
 panel.choice_cards[1].pressed.emit();assert(panel.canvas.current_plan().roofForm=="hip" and panel.choice_cards[1].button_pressed and not panel.choice_cards[0].button_pressed)
 panel.choice_cards[0].pressed.emit();assert(panel.canvas.current_plan().roofForm=="gable")
 panel.choice_cards[3].pressed.emit();assert(panel.canvas.current_plan().roofMat=="bark" and panel.choice_cards[3].button_pressed and not panel.choice_cards[2].button_pressed)
 panel.choice_cards[2].pressed.emit();assert(panel.canvas.current_plan().roofMat=="reed")
 var original_height:float=panel.height_choices.value
 panel.height_choices.value=original_height+10
 assert(float(panel.canvas.current_plan().roofHeight)==original_height+10)
 panel.canvas.undo();assert(panel.height_choices.value==original_height,"Undo must refresh roof height control")
 panel.canvas.redo();assert(panel.height_choices.value==original_height+10,"Redo must refresh roof height control")
 panel.reset_design();assert(panel.height_choices.value==original_height and panel.selected_category=="outer","Reset must restore roof controls and the initial category")
 assert(panel.canvas.add_floor());assert(panel.canvas.active_floor==1 and panel.measurements.text=="Mõõdud: —")
 panel.set_design_value("roofHeight",125);panel.select_floor(0)
 assert(panel.mini_plan.design.roofHeight==panel.canvas.current_plan().roofHeight)
 panel.select_floor(1);assert(panel.mini_plan.design.roofHeight==125);panel.select_floor(0)
 assert(panel.height_choices.value==original_height,"First floor controls must reflect its roof")
 panel.select_floor(1);assert(panel.height_choices.value==125,"Second floor controls must reflect its roof")
 panel.canvas.remove_floor();assert(panel.canvas.active_floor==0 and panel.height_choices.value==original_height)
 panel.canvas.undo();assert(panel.canvas.active_floor==1 and panel.height_choices.value==125,"Undo must restore the removed floor and its active controls")
 panel.canvas.redo();assert(panel.canvas.active_floor==0 and not panel.canvas.design.has("upper"),"Redo must restore the ground floor view")
 assert(panel.canvas.add_floor());panel.reset_design()
 assert(panel.canvas.active_floor==0 and not panel.canvas.design.has("upper"),"Restoring the sample must select the first floor")
 panel.canvas.undo();assert(panel.canvas.active_floor==1 and panel.canvas.design.has("upper"),"Undo must restore the second floor after resetting the sample")
 panel.select_category("items");assert(panel.item_choices.visible and panel.card_scroll.visible and panel.choice_cards.size()>1)
 await process_frame;await process_frame
 panel.card_scroll.scroll_horizontal=0
 panel.card_next.pressed.emit();assert(panel.card_scroll.scroll_horizontal>0,"Card arrows must reveal additional choices")
 panel.card_previous.pressed.emit();assert(panel.card_scroll.scroll_horizontal==0)
 panel.choice_cards[0].pressed.emit();assert(panel.canvas.tool=="item" and panel.canvas.item_type==str(panel.item_choices.get_item_metadata(0)))
 panel.toggle_preview();assert(panel.preview.visible and not panel.canvas.visible and not panel.dock_panel.visible)
 assert(panel.mini_plan.visible and not panel.mini_preview.visible and panel.mini_title_label.text=="Plaan" and panel.roof_overlay.visible)
 assert(panel.preview.aspect_fit(600,1200)>panel.preview.aspect_fit(1200,600)*2.0,"Portrait view must fit the house to its narrower width")
 panel.preview_roof_height.value=110;assert(float(panel.canvas.current_plan().roofHeight)==110)
 panel.preview.walking=true;panel.canvas.drag=true;panel.restore_history(false)
 assert(not panel.preview.walking and not panel.canvas.drag and panel.walk_button.text=="Kõnni","Undo must end walking and unfinished edits before replacing the plan")
 panel.preview.set_roof_visible(false)
 assert(not panel.preview.model.find_child("RoofDeck",true,false).visible and not panel.preview.model.find_child("OverlappingReedCourses",true,false).visible,"Roof toggle must hide the deck and reed courses")
 panel.preview.set_roof_visible(true)
 assert(panel.preview.model.find_child("RoofDeck",true,false).visible and panel.preview.model.find_child("OverlappingReedCourses",true,false).visible,"Roof toggle must restore the deck and reed courses")
 panel.preview.distance=30;panel.reset_view();assert(is_equal_approx(panel.preview.distance,panel.preview.initial_distance),"Reset must restore the design's fitted camera distance")
 panel.toggle_preview();assert(panel.canvas.visible and panel.dock_panel.visible)
 assert(not panel.mini_plan.visible and panel.mini_preview.visible and panel.mini_title_label.text=="3D eelvaade" and not panel.roof_overlay.visible)
 assert(panel.open_design("field","Põld"));assert(panel.selected_category=="area" and panel.canvas.tool=="plot");panel.select_category("settings")
 assert(panel.category_buttons.settings.text=="Põllu seaded")
 assert(panel.field_options.visible and not panel.build_choices.visible and panel.field_edge_choices.item_count==2 and panel.field_crop_choices.item_count==3)
 panel.field_edge_choices.select(1);panel.field_edge_choices.item_selected.emit(1)
 assert(panel.canvas.design.field.edge=="stones" and panel.ledger_text.text.contains("Serv: Kivirida"))
 panel.field_crop_choices.select(1);panel.field_crop_choices.item_selected.emit(1)
 assert(panel.canvas.design.field.crop=="wheat" and panel.ledger_text.text.contains("Vili: Nisu"))
 panel.canvas.undo();assert(panel.canvas.design.field.crop=="barley" and panel.field_crop_choices.selected==0)
 panel.toggle_preview();assert(not panel.roof_overlay.visible,"A field has no roof height controls");panel.toggle_preview()
 panel.reset_design();assert(panel.selected_category=="area" and panel.canvas.tool=="plot")
 assert(panel.open_design("field@2","Põld"))
 assert(panel.field_edge_choices.item_count==4 and panel.field_crop_choices.item_count==5)
 assert(panel.field_edge_choices.get_item_metadata(panel.field_edge_choices.selected)=="ditch" and panel.field_crop_choices.get_item_metadata(panel.field_crop_choices.selected)=="rye")
 panel.select_category("fence");assert(panel.tool_buttons.highStone.visible and panel.tool_buttons.rampart.visible)
 panel.stage_ref.size=Vector2(720,500);panel.update_stage_layout()
 assert(panel.overview_button.visible and not panel.ledger.visible)
 panel.overview_button.pressed.emit();assert(panel.ledger.visible,"Narrow layouts must allow opening the overview")
 panel.overview_button.pressed.emit();assert(not panel.ledger.visible)
 assert(panel.open_design("palisade","Palissaad") and panel.selected_category=="fence" and panel.canvas.tool=="rail")
 assert(panel.open_design("watchtower","Vahitorn") and panel.selected_category=="items" and panel.canvas.tool=="item")
 print("HOUSE_UI_FLOW_OK");panel.queue_free();quit()
