extends SceneTree
const Model=preload("res://scripts/house_plan_model.gd")
const Defaults=preload("res://data/house_default_designs.json")
const Detail=preload("res://scripts/detail_view.gd")
func _initialize() -> void:
 var model=Model.new();root.add_child(model)
 var design:Dictionary=Defaults.data.field.duplicate(true);model.rebuild(design)
 assert(model.find_child("FieldSoil",true,false) is MeshInstance3D)
 assert(model.find_child("FieldPlants",true,false) is MeshInstance3D)
 assert(model.find_child("FieldEars",true,false) is MeshInstance3D)
 assert(model.find_child("FieldBorder",true,false) is MeshInstance3D)
 assert(model.find_child("FieldFurrows",true,false) is MeshInstance3D)
 design.field.crop="fallow";design.field.edge="rail";model.rebuild(design)
 assert(model.find_child("FieldSoil",true,false) is MeshInstance3D)
 assert(model.find_child("FieldPlants",true,false)==null)
 assert(model.find_child("FieldRail",true,false) is MeshInstance3D)
 assert(model.get_children().filter(func(child):return child.get_meta("field_rail",false)).size()==5,"Long field rail must leave an entrance")
 design.field.edge="stones";model.rebuild(design)
 assert(model.find_child("FieldStone",true,false) is MeshInstance3D)
 design.field.crop="beans";model.rebuild(design)
 assert(model.find_child("FieldPlants",true,false) is MeshInstance3D and model.find_child("FieldEars",true,false)==null)
 var detail=Detail.new();var game_model=detail.create_designed_building("field",0,design)
 assert(game_model!=null and game_model.find_child("FieldPlants",true,false)!=null,"Game detail must use the custom field model")
 game_model.free();detail.free();Model.clear_cache()
 print("HOUSE_FIELD_OK");model.queue_free();quit()
