{
  "name": "kuningriigid-v330-frozen",
  "version": "0.330.0",
  "description": "Fixed offline V330 comparison build with no updates",
  "author": "orogdor",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "smoke": "electron . --native-smoke --no-sandbox"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "ee.kuningriigid.v330.frozen",
    "productName": "Kuningriigid V330 Frozen",
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "shared/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/game",
        "to": "game"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Kuningriigid-V330-FROZEN-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
